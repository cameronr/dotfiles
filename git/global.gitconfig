[alias]
	co = checkout
	br = branch
	ci = commit
	st = status

[init]
    defaultBranch = main

[pull]
    ff = only

[push]
    default = simple
	autoSetupRemote = true   # Automatically set upstream branch on push

[diff]
    colorMoved = default
	algorithm = histogram    # Clearer diffs on moved/edited lines
	mnemonicPrefix = true    # More intuitive refs in diff output

[merge]
    conflictstyle = diff3

[column]
	ui = auto 			     # Output in columns when possible
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Apply stored conflict resolutions automatically

[alias]
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

[delta]
    navigate = true    # use n and N to move between diff sections
    ; side-by-side = true
    line-numbers = true
    line-numbers-zero-style       = "#3b4261"

    minus-style                   = syntax "#4d1919"
    minus-non-emph-style          = syntax "#3A232B"
    minus-emph-style              = syntax "#713137"
    minus-empty-line-marker-style = syntax "#4d1919"
    line-numbers-minus-style      = "#b2555b"

    plus-style                    = syntax "#182f23"
    plus-non-emph-style           = syntax "#182f23"
    plus-emph-style               = syntax "#224e38"
    plus-empty-line-marker-style  = syntax "#182f23"
    line-numbers-plus-style       = "#3e8e66"

    #colorblind friendly
    ; minus-style                   = syntax "#808000"
    ; minus-non-emph-style          = syntax "#808000"
    ; minus-emph-style              = syntax "#bab02c"
    ; minus-empty-line-marker-style = syntax "#808000"
    ; line-numbers-minus-style      = "#bab02c"


    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

# vim: ft=gitconfig ts=4 sts=4 sw=4 et
