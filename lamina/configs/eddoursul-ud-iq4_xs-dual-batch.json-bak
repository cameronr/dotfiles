{
  "_comment": "Batch arm of the A/B (run-unsloth-batch.sh): same model, context, and GPU split as the prod config above, plus the phase-9 batch flags (--parallel 4, --batch-mtp, --adapt-every 1, --expert-cache auto). Context matches prod (--max-context 262144); with --batch-mtp every slot costs context-scaled VRAM (session, draft store, commit snapshots), so the startup fit may carve the 4 slots down - watch the engine's 'does not fit ... starting with N slots' / 'batch_slots=N' lines. --vram-reserve-mib 3072 (prod: 896) leaves the slots room beside the expert cache.",
  "model": "/data/unsloth-ud-iq4_xs-262k",
  "adapter_config": "/data/unsloth-ud-iq4_xs-262k/adapter-1m.safetensors",
  "expert_profile": "/data/unsloth-ud-iq4_xs-learned.bin",
  "exe": "/work/.p4-cbuild/strata",
  "mmproj": "/data/mmproj-bf16.gguf",
  "vision_exe": "@VISION_EXE@",
  "lib_dirs": ["@ENGINE_LIB@"],
  "gpu_split": "10,10",
  "host": "0.0.0.0",
  "port": 8080,
  "parallel": 4,
  "args": [
    "--prompt-cache", "4",
    "--adapter-scale", "1.0",
    "--expert-pcie-frac", "0.55",
    "--expert-cache", "auto",
    "--vram-reserve-mib", "3072",
    "--max-context", "262144",
    "--mtp", "/data/qwen36_dual/mtp-f16-f16.bin",
    "--spec", "4",
    "--batch-mtp",
    "--adapt-every", "1",
    "--prefill-chunk", "8192",
    "--prefill-borrow",
    "--second-gpu-prefetch-mb", "512",
    "--expert-pool-gib", "24",
    "--expert-cache-mb", "16384",
    "--expert-ram-budget-mb", "49152",
    "--expert-evict", "lfu",
    "--concurrency", "4"
  ]
}
