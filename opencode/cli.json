{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "leader": "ctrl+o",
    "session.tab.previous": "alt+left",
    "session.tab.next": "alt+right",
    "session.last": "alt+down"
  },
  "plugins": [
    {
      // from npm: @beta = 0.2.0-beta.3 (same code as local branch)
      "package": "@leohenon/opencode-vim-plugin@beta",
      "options": {
        "enabled": true,
        "vim_initial_mode": "normal",
        "vim_system_clipboard_register": true
      }
    },
    // local build, revert here if needed (symlink -> /Users/cam/Dev/opencode-vim-plugin/dist)
    // {
    //   "package": "./tui-plugins/opencode-vim-plugin",
    //   "options": {
    //     "enabled": true,
    //     "vim_initial_mode": "normal",
    //     "vim_system_clipboard_register": true
    //   }
    // },
    {
      "package": "./tui-plugins/tmux-status/"
    }
  ],
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true
  },
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": false
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
