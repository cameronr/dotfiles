{
  "$schema": "https://opencode.ai/config.json",

  "model": "local/qwen3.8",

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" }
  ],

  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "local",
      "options": {
        "baseURL": "{env:LLAMA_URL}"
      },
      "models": {
        "qwen3.8": {
          "limit": { "context": 262144, "output": 32768 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "default": {},
            "low": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "low" } } },
            "medium": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "medium" } } },
            "high": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "high" } } },
            "xhigh": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "xhigh" } } }
          }
        },
        "qwen3.8-27B-MTP-IQ4_KS": {
          "limit": { "context": 175000, "output": 32768 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "default": {},
            "low": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "low" } } },
            "medium": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "medium" } } },
            "high": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "high" } } },
            "xhigh": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "xhigh" } } }
          }
        },
        "qwen3.8-27B-vllm": {
          "limit": { "context": 175000, "output": 32768 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "default": {},
            "low": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "low" } } },
            "medium": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "medium" } } },
            "high": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "high" } } },
            "xhigh": { "extra_body": { "chat_template_kwargs": { "reasoning_effort": "xhigh" } } }
          }
        },
      }
    },
    "openrouter": {
      "models": {
        "poolside/laguna-s-2.1:free": {
          "name": "Poolside: Laguna S 2.1 (free)"
        }
      }
    }
  },

  "experimental": {
    "disable_paste_summary": true
  },

  "mcp": {
    "playwright": {
      "type": "local",
      // @playwright/mcp 0.0.79+ defaults to headed and --no-sandbox; pass --headless --sandbox explicitly.
      // Add "--headed" to watch the browser operate instead of running headless.
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--sandbox"],
      "enabled": true
    }
  }

  // "plugin": ["opencode-sandbox"]
}
