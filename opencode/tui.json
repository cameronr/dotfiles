{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "tokyonight",
  "keybinds": {
    "leader": "ctrl+o"
  },
  "plugin": [
    [
      "@leohenon/opencode-vim-plugin",
      {
        "enabled": true,
        "vim_initial_mode": "normal",
        "vim_system_clipboard_register": true
      }
    ],
    "./plugins/tmux-status.js"
  ],
  "attention": {
    "enabled": true, // requires OPENTUI_NOTIFICATION_PROTOCOL=osc777 for wezterm+tmux
    "sound": false
  }
}
